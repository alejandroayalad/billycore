{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-digest.sh\"",
            "timeout": 180,
            "statusMessage": "Recording the session digest"
          }
        ]
      }
    ]
  }
}
